// Isolated native settings operation. No helper units or board/document save.
// Legacy documented PCBServer.SystemOptions -> IPCB_SystemOptions.LockPreRoutes.
function SettingsBool(Value: Boolean): String;
begin
    if Value then Result := 'true' else Result := 'false';
end;

procedure SettingsReceipt(Stage, BeforeValue, AfterValue, ErrorCode: String;
                          Success, SetterAttempted, Changed, AlreadySatisfied: Boolean);
var Lines: TStringList;
begin
    Lines := TStringList.Create;
    try
        Lines.Text := __METADATA__ + ',"stage":"' + Stage + '","success":' + SettingsBool(Success) +
          ',"before":' + BeforeValue + ',"after":' + AfterValue +
          ',"setter_attempted":' + SettingsBool(SetterAttempted) + ',"changed":' + SettingsBool(Changed) +
          ',"already_satisfied":' + SettingsBool(AlreadySatisfied) + ',"error":"' + ErrorCode + '"}';
        Lines.SaveToFile(__RECEIPT_PATH__);
    finally
        Lines.Free;
    end;
end;

function SettingsGuard(Board: IPCB_Board): Boolean;
var Current: IPCB_Board; Doc: IServerDocument; Module: IDispatch;
begin
    Result := False;
    if PCBServer = nil then Exit;
    if Client.CurrentView = nil then Exit;
    Doc := Client.CurrentView.OwnerDocument;
    if Doc = nil then Exit;
    if not SameText(Doc.FileName, __PCB_PATH__) or not SameText(Doc.Kind, 'PCB') then Exit;
    Current := PCBServer.GetCurrentPCBBoard;
    if (Board = nil) or (Current = nil) then Exit;
    if not SameText(Board.FileName, __PCB_PATH__) or not SameText(Current.FileName, __PCB_PATH__) then Exit;
    if Board.I_ObjectAddress <> Current.I_ObjectAddress then Exit;
    Module := Client.ServerModuleByName('PCB');
    if Module = nil then Exit;
    if (Client.ProcessControl.ProcessDepth <> 0) or (Module.ProcessControl.ProcessDepth <> 0) then Exit;
    Result := True;
end;

procedure Run;
var Board: IPCB_Board; Options: IPCB_SystemOptions; BeforeValue, AfterValue: Boolean;
begin
    // Existing receipt means this operation already entered. Never replay it.
    if FileExists(__RECEIPT_PATH__) then Exit;
    SettingsReceipt('entered', 'null', 'null', '', False, False, False, False);
    if PCBServer = nil then Exit;
    Board := PCBServer.GetPCBBoardByPath(__PCB_PATH__);
    if not SettingsGuard(Board) then
    begin SettingsReceipt('guard_failed', 'null', 'null', 'exact_document_or_idle_guard', False, False, False, False); Exit; end;
    SettingsReceipt('before_options', 'null', 'null', '', False, False, False, False);
    Options := PCBServer.SystemOptions;
    if Options = nil then
    begin SettingsReceipt('guard_failed', 'null', 'null', 'system_options_missing', False, False, False, False); Exit; end;
    SettingsReceipt('before_getter', 'null', 'null', '', False, False, False, False);
    BeforeValue := Options.LockPreRoutes;
    if not SettingsGuard(Board) then
    begin SettingsReceipt('guard_failed', SettingsBool(BeforeValue), 'null', 'identity_changed_after_read', False, False, False, False); Exit; end;
__OPERATION_BODY__
end;
